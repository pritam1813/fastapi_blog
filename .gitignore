# Byte-compiled / optimized / Python-generated files
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info/

# Virtual Environments
.venv/
env/
venv/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Linter and Test Caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# User Uploaded Media (keep directory structure, ignore runtime uploads)
src/fastapi_blog/media/profile_pics/*
!src/fastapi_blog/media/profile_pics/.gitkeep
!src/fastapi_blog/media/profile_pics/author.png

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini